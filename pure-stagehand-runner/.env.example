# Required for OpenAI models.
OPENAI_API_KEY=PASTE_KEY_HERE

# Model used by the outer browser agent and internal Stagehand act/observe/extract calls.
# Examples:
#   openai/gpt-4.1-mini
#   openai/gpt-4.1
#   anthropic/claude-sonnet-4-5-20250929
#   google/gemini-2.0-flash
STAGEHAND_MODEL=openai/gpt-4.1-mini

# Optional for OpenAI-compatible gateways.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Browser language/locale. This keeps Google and most websites in English when
# they respect browser language headers. It is generic browser configuration,
# not site-specific automation logic.
BROWSER_LANG=en-US
BROWSER_ACCEPT_LANGUAGE=en-US,en;q=0.9

# Generic blocker-handling instruction passed to Stagehand's normal agent.
# This is not selector hardcoding. It only tells the agent to handle visible
# cookie/privacy/sign-in/ad/newsletter overlays when they block the task.
STAGEHAND_SYSTEM_PROMPT="If a cookie consent, privacy dialog, sign-in prompt, ad, newsletter modal, or other overlay blocks the task, handle it first using the visible controls. Prefer the least intrusive option that lets you continue, such as close, reject non-essential cookies, continue without sign-in, or accept only if needed. Do not spend steps on popups that do not block the task."

# Required only because this runner uses Stagehand callbacks to save artifacts.
# This does not replace Stagehand's DOM/ARIA logic.
STAGEHAND_EXPERIMENTAL=true

# Browser visibility. false means visible browser.
HEADLESS=false

# Used only when HEADLESS=false and no DISPLAY is already available.
# The run script starts Xvfb/openbox/x11vnc on these values.
STAGEHAND_DISPLAY_NUM=92
STAGEHAND_VNC_PORT=15992
STAGEHAND_NOVNC_PORT=16092
STAGEHAND_SCREEN=1365x768x24

# Keep the browser open after task completion for inspection.
KEEP_OPEN=false

# Default browser-agent step budget. Override per run with --max-steps.
STAGEHAND_MAX_STEPS=80

# Optional start URL. If empty, the task starts on about:blank.
START_URL=about:blank
