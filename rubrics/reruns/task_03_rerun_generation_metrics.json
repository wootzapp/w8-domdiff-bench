    "criterion_order": [
      "Use Microsoft Careers to search for an Applied Scientist role in/associated with Redmond, WA (or clearly report access blockers)",
      "Open one relevant listing and stop after opening one (or report that no exact match exists)",
      "Report the job number from the listing (or state it is not shown)",
      "Report the work-site arrangement from the listing (or state it is not shown)",
