    "criterion_order": [
      "Use the official NHTSA vPIC DecodeVinValues response for the specified VIN",
      "Record Make from Results object",
      "Record Model from Results object",
      "Record ModelYear from Results object",
      "Record BodyClass from Results object",
      "Record EngineCylinders from Results object",
      "Record EngineHP from Results object",
