    "criterion_order": [
      "Use Google Search to locate Gemini API documentation (attempt and navigation)",
      "Documentation source is an official Google domain and no sign-in is performed",
      "Record the documentation page title",
      "Record the documentation domain",
      "Identify the Python SDK shown in the documentation example",
