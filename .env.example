# Browser runtime
IMAGE=wootzapp/w8-core:latest
COMPOSE_PROJECT_NAME=w8-turns
CONTAINER_NAME=w8-turns-browser-engine
CDP_HOST_PORT=49345
NOVNC_HOST_PORT=16291
VNC_HOST_PORT=16011
CHROMIUM_HEADLESS=0
CHROMIUM_RESET_PROFILE=1
W8_RUN_NAME=benchmark
TASK_CATALOG_FILE=data/tasks.jsonl

# Actor configuration. Completion grading requires an explicit gpt-5.6-sol judge.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
# OPENAI_BASE_URL=https://api.openai.com/v1

# Evidence audit
EVIDENCE_AUDIT_MODEL=gpt-5.6-sol
EVIDENCE_ADJUDICATOR_MODEL=gemini-3.1-pro-preview
GEMINI_API_KEY=
# Optional provider overrides: openai or google.
EVIDENCE_AUDIT_PROVIDER=
EVIDENCE_ADJUDICATOR_PROVIDER=
