# Browser runtime
IMAGE=w8-core:domdiff-bench
COMPOSE_PROJECT_NAME=w8-recorder
CONTAINER_NAME=w8-core-browser-engine
CDP_HOST_PORT=49335
NOVNC_HOST_PORT=16191
VNC_HOST_PORT=15911
RUNNER_NOVNC_URL=http://127.0.0.1:16191/vnc.html?resize=scale&autoconnect=1&path=websockify
CHROMIUM_HEADLESS=0
CHROMIUM_RESET_PROFILE=0

# Model access
# Set OPENAI_MODEL for recording; gpt-5.6 matches the benchmark configuration.
OPENAI_API_KEY=
OPENAI_MODEL=

# Evidence audit
# Example model IDs; set both explicitly for an audit.
EVIDENCE_AUDIT_MODEL=gpt-5.6-sol
W8_RUN_NAME=run_1
EVIDENCE_ADJUDICATOR_MODEL=gemini-3.1-pro-preview
GEMINI_API_KEY=
# Optional provider overrides: openai or google.
EVIDENCE_AUDIT_PROVIDER=
EVIDENCE_ADJUDICATOR_PROVIDER=

