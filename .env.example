# Browser runtime
IMAGE=w8-core:domdiff-bench
COMPOSE_PROJECT_NAME=w8-recorder
CONTAINER_NAME=w8-core-browser-engine
CDP_HOST_PORT=49335
NOVNC_HOST_PORT=16191
VNC_HOST_PORT=15911
CHROMIUM_HEADLESS=0
CHROMIUM_RESET_PROFILE=1
W8_RUN_NAME=benchmark
TASK_CATALOG_URL=https://huggingface.co/datasets/WootzappLab/browser-agent-tasks/resolve/paired-capture/tasks.jsonl

# Actor and judge credentials
# Google: actors, rubrics, completion, native verifiers and evidence audit.
ACTOR_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Judge delivery
# Rubric preparation: gemini-3.1-pro-preview, normal requests.
# Completion: gemini-3.6-flash, JUDGE_TRANSPORT requests.
JUDGE_TRANSPORT=batch
NATIVE_JUDGE_PROFILE=primary

# Evidence audit
EVIDENCE_AUDIT_MODEL=gemini-3.1-pro-preview
EVIDENCE_ADJUDICATOR_MODEL=gemini-4-argon
