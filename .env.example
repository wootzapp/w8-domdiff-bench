# Browser runtime
IMAGE=w8-core:domdiff-bench
COMPOSE_PROJECT_NAME=w8-recorder
CONTAINER_NAME=w8-core-browser-engine
CDP_HOST_PORT=49335
NOVNC_HOST_PORT=16191
VNC_HOST_PORT=15911
CHROMIUM_HEADLESS=0
CHROMIUM_RESET_PROFILE=1
W8_RUN_NAME=benchmark
TASK_CATALOG_FILE=data/tasks.jsonl

# Actor and judge credentials
ACTOR_MODEL=gemini-3.1-pro-preview
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Evidence audit
EVIDENCE_AUDIT_MODEL=gemini-3.1-pro-preview
EVIDENCE_ADJUDICATOR_MODEL=gpt-6.1-sol
# Optional provider overrides: openai or google.
EVIDENCE_AUDIT_PROVIDER=
EVIDENCE_ADJUDICATOR_PROVIDER=
