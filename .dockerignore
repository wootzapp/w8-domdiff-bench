# The repository root is the Docker build context. Send only the browser
# payload and runtime files required by the image.
*
!Dockerfile
!build/
!build/**
!w8bench/
!w8bench/task_recorder/
!w8bench/task_recorder/runtime/
!w8bench/task_recorder/runtime/**
!w8bench/task_recorder/agent_browser/
!w8bench/task_recorder/agent_browser/runtime/
!w8bench/task_recorder/agent_browser/runtime/package.json
!w8bench/task_recorder/agent_browser/runtime/package-lock.json
