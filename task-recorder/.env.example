# w8-core image and isolated Docker identity for this checkout.
IMAGE=wootzapp/w8-core:latest
COMPOSE_PROJECT_NAME=w8-task-recorder
CONTAINER_NAME=w8-core-browser-engine

# Host-only ports. Change these if another local process already uses them.
CDP_HOST_PORT=49335
NOVNC_HOST_PORT=16191
VNC_HOST_PORT=15911

# This URL is printed if a run pauses for allowed human intervention.
RUNNER_NOVNC_URL=http://127.0.0.1:16191/vnc.html?resize=scale&autoconnect=1&path=websockify

# Model credentials used by the host-side recorder.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=replace-with-a-supported-model-name

# Visible w8-core configuration.
CHROMIUM_HEADLESS=0
CHROMIUM_RESET_PROFILE=0
