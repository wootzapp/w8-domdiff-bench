#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
AGENT_BROWSER_DIR="${REPO_ROOT}/w8bench/task_recorder/agent_browser/runtime"
IMAGE_NAME="${CHROMIUM_IMAGE_NAME:-w8-core:domdiff-bench}"
BUILD_DIR="${REPO_ROOT}/build"
CHROMIUM_SOURCE_DIR="${1:-${REPO_ROOT}/../w8-browser-build/chromium/src}"
OVERLAY_SOURCE_DIR="${2:-${REPO_ROOT}/../wootzapp-browser}"
VCS_REF="${IMAGE_VCS_REF:-$(git -C "${REPO_ROOT}" rev-parse HEAD)}"

if [ "$#" -gt 2 ]; then
  echo "Usage: scripts/build-browser-image [chromium-source-dir] [browser-overlay-dir]" >&2
  exit 1
fi

if [ ! -x "${BUILD_DIR}/chrome" ]; then
  echo "Missing executable Chromium payload: ${BUILD_DIR}/chrome" >&2
  echo "Copy your Chromium payload into ${BUILD_DIR}/ before building." >&2
  exit 1
fi

for required in package.json package-lock.json; do
  if [ ! -f "${AGENT_BROWSER_DIR}/${required}" ]; then
    echo "Missing agent-browser build input: ${AGENT_BROWSER_DIR}/${required}" >&2
    exit 1
  fi
done

# Verify source identities and exercise the staged executable before packaging.
BUILD_METADATA="$(python3 - "${REPO_ROOT}" "${CHROMIUM_SOURCE_DIR}" "${OVERLAY_SOURCE_DIR}" <<'PY'
import base64
import hashlib
import json
import os
import selectors
import signal
import subprocess
import sys
import tempfile
import time
from pathlib import Path

root, chromium, overlay = (Path(value).resolve() for value in sys.argv[1:])
settings = json.loads((root / "protocol/browser-build.json").read_text())
try:
    (root / "build/browser-build.json").unlink(missing_ok=True)
    overlay_revision = subprocess.check_output(
        ["git", "-C", str(overlay), "rev-parse", "HEAD"], text=True
    ).strip()
    if overlay_revision != settings["overlay_revision"]:
        raise ValueError("Browser overlay revision differs from protocol/browser-build.json")
    changes = subprocess.check_output(
        ["git", "-C", str(overlay), "status", "--porcelain", "--", "src"], text=True
    )
    if changes:
        raise ValueError("Browser overlay src/ contains uncommitted changes")
    version_fields = dict(
        line.split("=", 1) for line in (chromium / "chrome/VERSION").read_text().splitlines()
        if "=" in line
    )
    version = ".".join(version_fields[key] for key in ("MAJOR", "MINOR", "BUILD", "PATCH"))
    if version != settings["chromium_version"]:
        raise ValueError("Chromium version differs from protocol/browser-build.json")
    chromium_revision = subprocess.check_output(
        ["git", "-C", str(chromium), "rev-parse", "HEAD"], text=True
    ).strip()
    overlay_files = subprocess.check_output(
        ["git", "-C", str(overlay), "ls-files", "-z", "--", "src"]
    ).decode().split("\0")
    if not any(overlay_files):
        raise ValueError("Browser overlay has no tracked src/ files")
    for filename in filter(None, overlay_files):
        original = overlay / filename
        applied = chromium / Path(filename).relative_to("src")
        if original.is_symlink():
            if not applied.is_symlink() or original.readlink() != applied.readlink():
                raise ValueError(f"Applied overlay differs: {filename}")
        elif not applied.is_file() or original.read_bytes() != applied.read_bytes():
            raise ValueError(f"Applied overlay differs: {filename}")
    protocol = chromium / "third_party/blink/public/devtools_protocol/domains/ChromiumRL.pdl"
    protocol_sha256 = hashlib.sha256(protocol.read_bytes()).hexdigest()
    if (protocol_sha256 != settings["protocol_sha256"]
        or protocol_sha256 != hashlib.sha256((root / "protocol/ChromiumRL.pdl").read_bytes()).hexdigest()):
        raise ValueError("Browser protocol differs from the pinned protocol")
    # Stream the browser binary: reading a full Release binary into memory can
    # itself exhaust a small build machine.
    binary_hashes = []
    for binary in (root / "build/chrome", chromium / "out/Release/chrome"):
        digest = hashlib.sha256()
        with binary.open("rb") as stream:
            for chunk in iter(lambda: stream.read(1024 * 1024), b""):
                digest.update(chunk)
        binary_hashes.append(digest.hexdigest())
    if binary_hashes[0] != binary_hashes[1]:
        raise ValueError("Copied browser differs from the Chromium Release binary")
    with tempfile.TemporaryDirectory(prefix="w8-browser-check-") as profile, tempfile.TemporaryFile() as log:
        command_read, command_write = os.pipe()
        response_read, response_write = os.pipe()
        with os.fdopen(command_write, "wb", buffering=0) as commands, os.fdopen(response_read, "rb", buffering=0) as responses:
            try:
                browser = subprocess.Popen(
                    ["bash", "-c", 'exec 3<&"$1" 4>&"$2"; shift 2; exec "$@"', "browser-check",
                     str(command_read), str(response_write), str(root / "build/chrome"),
                     "--headless", "--no-sandbox", "--disable-gpu", "--disable-dev-shm-usage",
                     "--disable-background-networking", "--disable-component-update",
                     "--disable-extensions", "--no-first-run", "--no-default-browser-check",
                     f"--user-data-dir={profile}", "--remote-debugging-pipe", "about:blank"],
                    pass_fds=(command_read, response_write), stdout=log, stderr=log,
                    start_new_session=True,
                )
            finally:
                os.close(command_read)
                os.close(response_write)
            try:
                buffer, session_id, snapshot = b"", None, None
                methods = ["Target.createTarget", "Target.attachToTarget", "Runtime.evaluate",
                           "ChromiumRL.enable", "ChromiumRL.captureStructuredSnapshot",
                           "ChromiumRL.getModelDOM", "Page.captureScreenshot"]
                deadline = time.monotonic() + 30
                with selectors.DefaultSelector() as selector:
                    selector.register(responses, selectors.EVENT_READ)
                    for call_id, method in enumerate(methods, 1):
                        params = {}
                        if method == "Target.createTarget":
                            params = {"url": "about:blank"}
                        elif method == "Target.attachToTarget":
                            params = {"targetId": result["targetId"], "flatten": True}
                        elif method == "Runtime.evaluate":
                            params = {"expression": "document.body.innerHTML = '<main><p>ChromiumRL build check</p><button>Verify capture</button></main>'; new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(() => resolve(true))))",
                                      "awaitPromise": True, "returnByValue": True}
                        elif method == "ChromiumRL.captureStructuredSnapshot":
                            params = {"inViewportOnly": True, "maxNodes": 100, "maxTextChars": 10000}
                        elif method == "ChromiumRL.getModelDOM":
                            params = {"snapshot": snapshot}
                        request = {"id": call_id, "method": method, "params": params}
                        if session_id:
                            request["sessionId"] = session_id
                        commands.write(json.dumps(request).encode() + b"\0")
                        while True:
                            remaining = deadline - time.monotonic()
                            if remaining <= 0:
                                raise ValueError(f"Staged browser capability check timed out at {method}")
                            if b"\0" not in buffer:
                                if not selector.select(remaining):
                                    raise ValueError(f"Staged browser capability check timed out at {method}")
                                chunk = os.read(responses.fileno(), 65536)
                                if not chunk:
                                    raise ValueError(f"Staged browser closed the CDP pipe at {method}")
                                buffer += chunk
                                continue
                            message, buffer = buffer.split(b"\0", 1)
                            reply = json.loads(message)
                            if reply.get("id") == call_id:
                                break
                        if "error" in reply:
                            raise ValueError(f"Staged browser {method} failed: {reply['error']}. Compile Chromium after applying the overlay.")
                        result = reply.get("result", {})
                        if method == "Target.attachToTarget":
                            session_id = result["sessionId"]
                        elif method == "Runtime.evaluate" and result.get("exceptionDetails"):
                            raise ValueError("Staged browser could not prepare the local capture fixture")
                        elif method == "ChromiumRL.captureStructuredSnapshot":
                            snapshot = result["snapshot"]
                            if not snapshot.get("nodes") or "ChromiumRL build check" not in json.dumps(snapshot):
                                raise ValueError("Staged browser structured capture did not contain the local fixture")
                        elif method == "ChromiumRL.getModelDOM":
                            if "ChromiumRL build check" not in json.dumps(result["modelDOM"].get("sections")):
                                raise ValueError("Staged browser model DOM did not contain the local fixture")
                        elif method == "Page.captureScreenshot":
                            if not base64.b64decode(result["data"], validate=True).startswith(b"\x89PNG\r\n\x1a\n"):
                                raise ValueError("Staged browser screenshot was not a PNG")
            except Exception:
                log.seek(0, 2)
                log.seek(max(0, log.tell() - 2000))
                print(log.read().decode("utf-8", errors="replace"), file=sys.stderr)
                raise
            finally:
                try:
                    try:
                        commands.write(json.dumps({"id": len(methods) + 1, "method": "Browser.close"}).encode() + b"\0")
                    except OSError:
                        pass
                    try:
                        browser.wait(timeout=5)
                    except subprocess.TimeoutExpired:
                        pass
                finally:
                    try:
                        os.killpg(browser.pid, signal.SIGKILL)
                    except ProcessLookupError:
                        pass
                    browser.wait(timeout=5)
    receipt = {
        **settings,
        "chromium_revision": chromium_revision,
        "binary_sha256": binary_hashes[0],
        "source_verification": "overlay files and Release payload matched; staged ChromiumRL capture verified",
        "capability_check": {"methods": methods[3:], "local_fixture": "passed"},
    }
    (root / "build/browser-build.json").write_text(json.dumps(receipt, indent=2) + "\n")
except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
    raise SystemExit(f"Browser build provenance check failed: {error}")
print(version)
print(overlay_revision)
print(chromium_revision)
print(protocol_sha256)
PY
)"
mapfile -t BUILD_FIELDS <<< "${BUILD_METADATA}"
IMAGE_VERSION="${IMAGE_VERSION:-chromium-${BUILD_FIELDS[0]}}"

"${BUILD_DIR}/chrome" --version
du -sh "${BUILD_DIR}"

cd "${REPO_ROOT}"
docker buildx build \
  --load \
  --build-arg "IMAGE_VERSION=${IMAGE_VERSION}" \
  --build-arg "VCS_REF=${VCS_REF}" \
  --build-arg "BROWSER_OVERLAY_REVISION=${BUILD_FIELDS[1]}" \
  --build-arg "CHROMIUM_REVISION=${BUILD_FIELDS[2]}" \
  --build-arg "BROWSER_PROTOCOL_SHA256=${BUILD_FIELDS[3]}" \
  --tag "${IMAGE_NAME}" \
  --file Dockerfile \
  .

echo "Built ${IMAGE_NAME}"
