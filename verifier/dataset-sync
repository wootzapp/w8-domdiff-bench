#!/usr/bin/env bash
set -euo pipefail

repo_root="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
python_bin="$repo_root/.venv/bin/python"

if [[ ! -x "$python_bin" ]]; then
  echo "error: missing $python_bin; install verifier/requirements.txt first" >&2
  exit 2
fi

exec "$python_bin" -m scripts.dataset_sync "$@"
