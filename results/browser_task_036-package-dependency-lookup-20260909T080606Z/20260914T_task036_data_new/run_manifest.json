    "criterion_order": [
      "Access the Debian Bookworm curl package page (packages.debian.org/bookworm/curl)",
      "Report the Bookworm curl package version",
      "List every architecture in the 'Download curl' table",
      "List all required dependencies under 'Depends' with displayed version constraints",
