    "criterion_order": [
      "Access BBC Technology section (bbc.com/technology) without signing in",
      "Record the five most recent BBC Technology headlines",
      "Record publication timestamps exactly as displayed for each of the five headlines",
      "Stop after recording five newest headlines and timestamps",
